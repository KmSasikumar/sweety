# Sweety — environment variables.
# Copy this file to backend/.env and adjust the values for your setup.
# Never commit a real .env — it can hold secrets.

# Port the API listens on
PORT=4000

# PostgreSQL connection (used by backend/src/db.js)
PGHOST=localhost
PGPORT=5432
PGUSER=sweety
PGPASSWORD=sweety
PGDATABASE=sweety

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
